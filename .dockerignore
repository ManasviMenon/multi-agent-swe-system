# Keep the build context small and the image reproducible. The container builds its own
# environment from requirements.txt and clones marshmallow itself, so none of the local
# machine's state should leak in.
.venv/
.cache/
results/
.git/
.github/
.env
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
node_modules/
dashboard/
